# Sao chép thành apps/api/.env khi cần ghi đè. KHÔNG điền khóa thật vào file này.
APP_ENV=local
GCP_PROJECT_ID=demo-aisrm
FIREBASE_PROJECT_ID=demo-aisrm
STORAGE_BUCKET=demo-aisrm.appspot.com
AI_MODE=mock
UNI_DATA360_MODE=mock
UNI_DATA360_BASE_URL=
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8080
# Chỉ dùng khi chạy local với Firebase Emulator Suite
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
