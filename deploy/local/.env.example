# Cấu hình AI-SRM bản Local. cai-dat.ps1 / cai-dat.sh tự tạo .env từ tệp này và sinh mật khẩu ngẫu nhiên.
# KHÔNG chia sẻ tệp .env: chứa mật khẩu CSDL và khóa mã hóa.

AISRM_VERSION=1.0
# Cổng web (truy cập http://<máy chủ>:<cổng>)
HTTP_PORT=80

# Sinh ngẫu nhiên khi cài đặt — GIỮ NGUYÊN sau khi đã có dữ liệu
POSTGRES_PASSWORD=__RANDOM__
LOCAL_SECRET_KEY=__RANDOM__

# Máy chủ AI nội bộ (Ollama / LocalAI). Để trống nếu chưa dùng AI nội bộ.
#   Dùng container ollama đi kèm:     http://ollama:11434
#   Máy chủ AI riêng trong mạng trường: http://10.0.0.5:11434
LOCAL_AI_BASE_URL=

# Thư điện tử thông báo (máy chủ thư của trường). Để trống nếu chưa dùng.
#   SMTP_URL=smtp://tai-khoan:mat-khau@mail.truong.edu.vn:587
#   MAIL_FROM=AI-SRM <ai-srm@truong.edu.vn>
SMTP_URL=
MAIL_FROM=
# Địa chỉ web của hệ thống (dùng trong liên kết trong thư), vd https://aisrm.truong.edu.vn
PUBLIC_BASE_URL=
